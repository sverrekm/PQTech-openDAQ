# PQTech-openDAQ — node-lokal konfig (KOPIER til .env ved behov)
# =============================================================
# .env er med vilje IKKJE i repoet (sjå .gitignore): ligg han der, får kvar
# klona node same IP og kolliderer på LAN-et. Utan .env køyrer noden DHCP —
# containeren hentar sjølv ein lease, so mange nodar kan stå på same nett.
# Captive-portalen (first-boot) og `pqtech-config.sh` skriv .env for deg.
#
# Alle felta er valfrie. Standard (ingen .env) = DHCP, auto parent, node-modus.

# --- IP-modus ---------------------------------------------------------------
# dhcp   = ekte lease frå ruteren (standard, tilrådd — ingen kollisjon)
# static = fast IP (då legg start.sh på docker-compose.static.yml)
#IP_MODE=dhcp

# Berre for IP_MODE=static: fast IP + (valfritt) subnett/gateway.
#CONTAINER_IP=192.168.1.50
#NET_SUBNET=192.168.1.0/24
#NET_GATEWAY=192.168.1.1

# macvlan-parent (kabla grensesnitt). Tom = auto-detektert frå default-rute.
#NET_PARENT=eth0

# --- Lagring ----------------------------------------------------------------
# Host-katalog for måledata + databasar (montert til /data/maalinger).
#DATA_DIR=./maalinger
# NAS-mountpunkt (montert til /data/nas). Tom = lokal ./nas.
#NAS_DIR=/mnt/nas/pqtech

# --- Node ↔ hub -------------------------------------------------------------
# Delt token for /api/ingest (node→hub). Kan òg setjast i konfig/push.json.
#INGEST_TOKEN=

# Unik device-indeks for daqref-localId (auto frå Pi-serienr om tom).
#OPENDAQ_DEVICE_IDX=0
