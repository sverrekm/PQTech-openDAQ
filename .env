# Container-IP for macvlan-nettverk
# Endre denne for aa gi containeren ein annan IP paa LAN-et.
# Krev: docker compose down && docker compose up -d
CONTAINER_IP=192.168.1.161

# Host-katalog der maaledata + databasar vert lagra (montert til /data/maalinger
# i containeren). Absolutt sti (t.d. /mnt/ssd/pqtech) eller relativ (./maalinger).
# Endrast enklast via: sudo bash pqtech-config.sh -> Datalagring
DATA_DIR=./maalinger
