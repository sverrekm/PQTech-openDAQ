{
  "navn": "SIRIUS OPC-UA - Strøm/Spenning",
  "beskrivelse": "Oppsett for Dewesoft SIRIUS via OPC-UA nettverk. Endre 'adresse' til IP-adressen til SIRIUS/gateway-PC.",

  "tilkobling": {
    "type": "opcua",
    "adresse": "192.168.1.100"
  },

  "sampling": {
    "sample_rate": 10000,
    "varighet_sekunder": 10.0,
    "pre_trigger_sekunder": 0.0
  },

  "kanaler": [
    {
      "indeks": 0,
      "navn": "Strom L1",
      "type": "stroem",
      "enhet": "A",
      "egenskaper": {}
    },
    {
      "indeks": 1,
      "navn": "Spenning L1",
      "type": "spenning",
      "enhet": "V",
      "egenskaper": {}
    }
  ],

  "eksport": {
    "format": "csv",
    "utmappe": "./maalinger",
    "inkluder_tidsstempler": true,
    "inkluder_metadata": true
  },

  "opendaq_konfig": null
}
